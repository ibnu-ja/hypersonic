using Gtk 4.0;
using Adw 1;

template $Window: Adw.ApplicationWindow {
  content: WindowHandle {
    child: Stack main_stack {
      transition-duration: 200;
      transition-type: crossfade;

      StackPage {
        child: Adw.ToolbarView {
          content: $WelcomePage welcome_page {};

          [top]
          Adw.HeaderBar {
            show-title: false;
          }
        };

        name: "welcome";
      }

      StackPage {
        child: Adw.ToolbarView {
          content: Adw.StatusPage {
            child: Spinner {
              halign: center;
              spinning: true;
            };

            description: _("Connecting to your server");
            title: _("Connecting…");
          };

          [top]
          Adw.HeaderBar {
            show-title: false;
          }
        };

        name: "loading";
      }

      StackPage {
        child: Box {
          halign: fill;
          orientation: vertical;

          Adw.ToastOverlay {
            vexpand: true;

            Adw.OverlaySplitView split_view {
              content: Adw.NavigationPage {
                child: Stack content_stack {
                  transition-type: slide_up_down;

                  StackPage {
                    child: Adw.ToolbarView {
                      [top]
                      Adw.HeaderBar {
                        title-widget: Adw.WindowTitle {
                          title: "Home_Page";
                        };

                        ToggleButton {
                          active: bind split_view.show-sidebar bidirectional;
                          icon-name: "sidebar-show-symbolic";
                          visible: bind split_view.collapsed bidirectional;
                        }
                      }
                    };

                    name: "home_page";
                  }

                  StackPage {
                    child: Adw.NavigationSplitView player_split_view {
                      content: Adw.NavigationPage {
                        Adw.ToolbarView {
                          [top]
                          Adw.HeaderBar {
                            title-widget: Adw.WindowTitle {
                              subtitle: "player";
                              title: "subtitle";
                            };

                            [start]
                            ToggleButton sidebar_toggle {
                              active: bind split_view.show-sidebar bidirectional;
                              icon-name: "sidebar-show-symbolic";
                              visible: bind split_view.collapsed bidirectional;
                            }

                            [end]
                            Button back {
                              action-name: "navigation.push";
                              action-target: "'queue'";
                              has-frame: false;
                              icon-name: "view-more-symbolic";
                            }
                          }

                          Label {
                            label: "test";
                          }
                        }
                      };

                      max-sidebar-width: 1000;
                      min-sidebar-width: 0;

                      sidebar: Adw.NavigationPage {
                        child: Adw.ToolbarView {
                          content: Label {
                            label: "test";
                          };

                          [top]
                          Adw.HeaderBar {
                            title-widget: Adw.WindowTitle {
                              subtitle: "Queue";
                              title: "subtitle";
                            };
                          }
                        };

                        tag: "queue";
                      };

                      sidebar-position: end;
                      sidebar-width-fraction: 0.5;
                    };

                    name: "player_page";
                  }

                  StackPage {
                    child: Adw.ToolbarView {
                      content: Adw.StatusPage {
                        description: "testing";
                        icon-name: "application-x-executable";
                        title: "Testing page";
                      };

                      [top]
                      Adw.HeaderBar {
                        title-widget: Adw.WindowTitle {};
                      }
                    };

                    name: "testing_page";
                  }
                };

                title: _("Content");
              };

              max-sidebar-width: 240;

              sidebar: Adw.ToolbarView {
                content: $Sidebar sidebar {};

                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle content_title {
                    title: _("Hypersonic");
                  };

                  [end]
                  MenuButton menu_btn {
                    icon-name: "open-menu-symbolic";
                    primary: true;
                    tooltip-text: _("Menu");
                  }
                }

                styles [
                  "light-right-edge",
                ]
              };

              sidebar-width-fraction: 0.2;
              sidebar-width-unit: px;

              styles [
                "light-right-edge",
              ]
            }
          }

          Revealer player_bar_revealer {
            child: $PlayerBar player_bar {};

            hexpand: true;
            reveal-child: true;
            transition-type: slide_up;
          }
        };

        name: "content";
      }
    };
  };

  default-height: 500;
  default-width: 600;
  height-request: 640;
  width-request: 360;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      player_split_view.collapsed: true;
    }
  }
}

Adw.AboutDialog about {
  application-icon: "moe.seiga.Hypersonic";
  application-name: "Hypersonic";
  license-type: gpl_3_0;
  website: "https://github.com/ibnu-ja/hypersonic";
}

Adw.Toggle {}
